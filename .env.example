# Copy to .env and fill in. .env is gitignored — keep it off GitHub.
#
#   cp .env.example .env
#   docker compose up -d --build

# Required. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First-run console password. Leave blank and the app generates a random one,
# printed once to the container log:  docker compose logs iridium-web
ADMIN_PASSWORD=

# "true" when behind nginx/TLS, which marks the session cookie Secure.
# Set to "false" if you ever run it on plain HTTP, or you cannot log in.
BEHIND_TLS=true

# Optional. Better entered on the Settings page so they never touch the disk.
ROCKBLOCK_USER=
ROCKBLOCK_PASS=
ROCKBLOCK_IMEI=

# ---------------------------------------------------------------------------
# Only needed with docker-compose.caddy.yml (lucaslorentz/caddy-docker-proxy).
# The site Caddy already serves, or a subdomain you have pointed at this host.
CADDY_SITE=
# Sub-path to mount under. Ignored if you switch the overlay to subdomain mode.
CADDY_PATH=/iridium
